strep_pairwise <- as.data.frame(emmeans(strep_bin_model,
pairwise ~ antibiotic,
type = "response")$contrasts) |>
mutate(OR = exp(estimate),  # odds ratio
lower.CI = exp(estimate - 1.96 * SE),  # 95% CI lower
upper.CI = exp(estimate + 1.96 * SE))   # 95% CI upper
source("~/GitHub/AMR_REX25/pneumonia.R", echo = TRUE)
strep_pairwise <- as.data.frame(emmeans(strep_bin_model,
pairwise ~ antibiotic,
type = "response")$contrasts) |>
mutate(OR = exp(estimate), lower.CI = exp(estimate - 1.96 * SE),
upper.CI = exp(estimate + 1.96 * SE))
View(strep_pairwise)
View(strep_pairwise)
