upper.CI = exp(upper.CL))   # upper CI
View(strep_pair_ci)
strep_pairwise_results <- as.data.frame(strep_pair_ci) |>
mutate(OR = exp(estimate),        # odds ratio
lower.CI = exp(asymp.LCL),  # lower CI
upper.CI = exp(asymp.UCL))   # upper CI
strep_pairwise_results |>
ggplot(aes(x = contrast, y = odds.ratio)) +
