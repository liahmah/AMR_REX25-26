filter(susceptibility == "Susceptible" | susceptibility == "Resistant") |>
mutate(suscep_logical = susceptibility == "Susceptible")
## binomial logistic regression
bin_model <- glm(suscep_logical ~ order_time_jittered_utc + antibiotic,
data = staph_aur_logical,
family = binomial)
summary(bin_model)
strep_bin_model <- glm(suscep_logical ~ antibiotic,
data = strep_pneum_logical,
family = binomial)
summary(strep_bin_model)
strep_bin_results <- summary(strep_bin_model)
coef_table <- strep_bin_results$coefficients
coef_table
strep_bin_results
# extracting results:
estimates <- strep_bin_results[, "Estimate"]
strep_bin_summary <- summary(strep_bin_model)
# extracting results:
streo_bin_extract <- strep_bin_summary$coefficients
estimates <- strep_bin_extract[, "Estimate"]
# extracting results:
strep_bin_extract <- strep_bin_summary$coefficients
estimates <- strep_bin_extract[, "Estimate"]
strep_std_errors <- strep_bin_extract[, "Std. Error"]
strep_zvalues <- strep_bin_extract[, "z value"]
strep_signif <- strep_bin_extract[, "Pr(>|z|)"]
results <- data.frame(
Estimate = strep_estimates,
StdError = strep_std_errors,
zValue = strep_zvalues,
pValue = strep_pvalues) |>
mutate(OddsRatio = exp(Estimate))
# extracting results:
strep_bin_extract <- strep_bin_summary$coefficients
strep_estimates <- strep_bin_extract[, "Estimate"]
strep_std_errors <- strep_bin_extract[, "Std. Error"]
strep_zvalues <- strep_bin_extract[, "z value"]
strep_pvalues <- strep_bin_extract[, "Pr(>|z|)"]
results <- data.frame(
Estimate = strep_estimates,
StdError = strep_std_errors,
zValue = strep_zvalues,
pValue = strep_pvalues) |>
mutate(OddsRatio = exp(Estimate))
strep_bin_results <- data.frame(
Estimate = strep_estimates, StdError = strep_std_errors,
zValue = strep_zvalues, pValue = strep_pvalues) |>
mutate(OddsRatio = exp(Estimate))
View(strep_bin_results)
pred_probs <- predict(strep_bin_model, type = "response")
head(pred_probs)
View(strep_bin_results)
## STREP
# setting pencillin as reference level:
suscep_logical$antibiotic <- relevel(suscep_logical$antibiotic,
ref = "Penicillin")
## STREP
# setting pencillin as reference level:
strep_pneum_logical$antibiotic <- relevel(strep_pneum_logical$antibiotic,
ref = "Penicillin")
strep_bin_model <- glm(suscep_logical ~ antibiotic,
data = strep_pneum_logical,
family = binomial)
strep_bin_summary <- summary(strep_bin_model)
# extracting results:
strep_bin_extract <- strep_bin_summary$coefficients
strep_estimates <- strep_bin_extract[, "Estimate"]
strep_std_errors <- strep_bin_extract[, "Std. Error"]
strep_zvalues <- strep_bin_extract[, "z value"]
strep_pvalues <- strep_bin_extract[, "Pr(>|z|)"]
strep_bin_results <- data.frame(
Estimate = strep_estimates, StdError = strep_std_errors,
zValue = strep_zvalues, pValue = strep_pvalues) |>
mutate(OddsRatio = exp(Estimate))
View(strep_bin_results)
library(emmeans)
library(tidyverse)
library(MASS)
library(emmeans)
data_susceptibility <- read_csv("datasets/microbiology_cultures_cohort.csv") |>
mutate(across(c("pat_enc_csn_id_coded", "order_proc_id_coded"), as.double))
data_demographics <- read_csv("datasets/microbiology_cultures_demographics.csv")
demo_suscep <- merge(data_demographics, data_susceptibility,
by = c("order_proc_id_coded", "pat_enc_csn_id_coded",
"anon_id")) |>
filter(organism != "Null")
species <- as.data.frame(unique(demo_suscep$organism))
data_organisms <- demo_suscep |>
filter(organism == "STREPTOCOCCUS PNEUMONIAE" |
organism == "STAPHYLOCOCCUS AUREUS" |
organism == "STAPH AUREUS {MRSA}" |
organism == "MYCOBACTERIUM TUBERCULOSIS COMPLEX BY DNA PROBE") |>
filter(susceptibility == "Resistant" |
susceptibility == "Susceptible") |>
mutate(suscep_logical = susceptibility == "Susceptible")
count_suscep_organisms <- data_organisms |>
count(antibiotic, susceptibility, organism)
strep_pneum <- data_susceptibility |>
filter(organism == "STREPTOCOCCUS PNEUMONIAE")
strep_pneum_n <- strep_pneum |>
mutate(antibiotic = as.factor(antibiotic))
table(strep_pneum_n$antibiotic, strep_pneum_n$susceptibility)
strep_pneum_n <- strep_pneum_n |>
filter(!antibiotic %in% c("Chloramphenicol", "Daptomycin", "Ertapenem",
"Tetracycline"))
strep_pneum_logical <- strep_pneum_n |>
filter(susceptibility == "Susceptible" | susceptibility == "Resistant") |>
mutate(suscep_logical = susceptibility == "Susceptible")
staph_aur <- data_susceptibility |>
filter(organism == "STAPHYLOCOCCUS AUREUS")
staph_aur_n <- staph_aur |>
add_count(antibiotic, susceptibility, name = "count") |>
mutate(antibiotic = as.factor(antibiotic))
staph_aur_logical <- staph_aur_n |>
filter(susceptibility == "Susceptible" | susceptibility == "Resistant") |>
mutate(suscep_logical = susceptibility == "Susceptible")
staph_aur_mrsa <- data_susceptibility |>
filter(organism == "STAPH AUREUS {MRSA}")
staph_aur_mrsa_n <- staph_aur_mrsa |>
add_count(antibiotic, susceptibility, name = "count") |>
mutate(antibiotic = as.factor(antibiotic))
staph_aur_mrsa_logical <- staph_aur_mrsa_n |>
filter(susceptibility == "Susceptible" | susceptibility == "Resistant") |>
mutate(suscep_logical = susceptibility == "Susceptible")
## MYCOBACTERIUM TUBERCULOSIS
myco_tub <- data_susceptibility |>
filter(organism == "MYCOBACTERIUM TUBERCULOSIS COMPLEX BY DNA PROBE")
## binomial logistic regression
bin_model <- glm(suscep_logical ~ order_time_jittered_utc + antibiotic,
data = staph_aur_logical,
family = binomial)
strep_bin_model <- glm(suscep_logical ~ antibiotic,
data = strep_pneum_logical,
family = binomial)
emmeans(strep_bin_model, pairwise ~ antibiotic, type = "response")
emmeans(strep_bin_model, pairwise ~ antibiotic, type = "response")
# extracting results:
strep_emm_results <- as.data.frame(strep_emm)
strep_emm <- emmeans(strep_bin_model, pairwise ~ antibiotic, type = "response")
# extracting results:
strep_emm_results <- as.data.frame(strep_emm)
# extracting results:
strep_emm <- emmeans(strep_bin_model, ~ antibiotic, type = "response")
strep_emm_results <- as.data.frame(strep_emm)
View(strep_emm_results)
# visualizations ----------------------------------------------------------
strep_emm_results |>
ggplot(aes(x = reorder(antibiotic, prob), y = prob)) +
geom_col(fill = "steelblue") +
geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL), width = 0.2) +
coord_flip() +  # flip axes for easier reading
labs(
x = "Antibiotic",
y = "Predicted probability of susceptibility",
title = "Predicted Susceptibility by Antibiotic"
) +
theme_minimal()
# visualizations ----------------------------------------------------------
strep_emm_results |>
ggplot(aes(x = reorder(antibiotic, prob), y = prob)) +
geom_col(fill = "steelblue") +
geom_errorbar(aes(ymin = asymp.LCL, ymax = asymp.UCL), width = 0.2) +
coord_flip() +  # flip axes for easier reading
labs(
x = "Antibiotic",
y = "Predicted probability of susceptibility",
title = "Predicted Susceptibility by Antibiotic"
) +
theme_minimal()
strep_pairwise <- emmeans(strep_bin_model, pairwise ~ antibiotic, type = "response")$contrasts
strep_pairwise <- as.data.frame(
emmeans(strep_bin_model, pairwise ~ antibiotic, type = "response")$contrasts
)
strep_pairwise <- as.data.frame(
emmeans(strep_bin_model, pairwise ~ antibiotic, type = "response")$contrasts
) |>
ggplot(aes(x = contrast, y = odds.ratio)) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL), width = 0.2) +
labs(
x = "Antibiotic comparison",
y = "Odds ratio of susceptibility",
title = "Pairwise Odds Ratios of Antibiotic Susceptibility"
) +
theme_minimal() +
coord_flip()
