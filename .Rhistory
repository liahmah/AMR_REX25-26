chisq_penicillin <- summarized_antibiotic |>
filter(antibiotic == "Penicillin",
susceptibility == "resistant" | susceptibility == "susceptible") |>
table(summarized_antibiotic$antibiotic, summarized_antibiotic$susceptibility)
# could also use chi square for antibiotic-specific comparisons
penicillin <- summarized_antibiotic |>
filter(antibiotic == "Penicillin",
susceptibility == "resistant" | susceptibility == "susceptible")
?table
chisq_penicillin <- table(summarized_antibiotic$antibiotic, summarized_antibiotic$susceptibility)
chisq.test(chisq_penicillin)
chisq$expected
chisq <- chisq.test(chisq_penicillin)
chisq$expected
View(penicillin)
View(summarized_antibiotic)
