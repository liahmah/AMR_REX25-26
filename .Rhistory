library(tidyverse)
merged_asthma_suscep <- read_csv("datasets/merged_asthma_susceptibility.csv")
## summarizing number of resistant/susceptible per organism by antibiotic
summarized_organism <- merged_asthma_suscep |>
count(antibiotic, organism, susceptibility) |>
rename('count' = 'n')
View(summarized_organism)
pneum <- summarized_organism |>
filter(organism == "STREPTOCOCCUS PNEUMONIAE")
View(pneum)
sum(pneum$count)
library(tidyverse)
library(MASS)
library(emmeans)
asthma_dataset <- read_csv("datasets/merged_asthma_susceptibility.csv")
pneumonia <- asthma_dataset |>
count(antibiotic, organism, susceptibility) |>
rename('count' = 'n') |>
filter(organism == "STREPTOCOCCUS PNEUMONIAE") |>
pivot_wider(names_from = susceptibility,
values_from = count)
pneumonia$antibiotic <- as.factor(pneumonia$antibiotic)
View(asthma_dataset)
View(pneumonia)
# set levels as penicillin, most commonly prescribed and of resistance concern
sum_anti_wide$antibiotic <- relevel(sum_anti_wide$antibiotic, ref = "PenicilLin")
# set levels as penicillin, most commonly prescribed and of resistance concern
pneumonia$antibiotic <- relevel(pneumonia$antibiotic, ref = "PenicilLin")
# set levels as penicillin, most commonly prescribed and of resistance concern
pneumonia$antibiotic <- relevel(pneumonia$antibiotic, ref = "Penicillin")
# then, run binomial regression
pneum_model <- glm(cbind(Resistant, Susceptible) ~ antibiotic,
family = binomial,
data = pneumonia)
summary(pneum_model)
# confirm via Tukey
tukey_pneum <- glm(cbind(Resistant, Susceptible) ~ antibiotic,
family = binomial,
data = pneumonia)
pairs(emmeans(tukey_pneum, ~ antibiotic), adjust = "tukey")
# then, run binomial regression
pneum_model <- glm(cbind(Susceptible, Resistant) ~ antibiotic,
family = binomial,
data = pneumonia)
summary(pneum_model) # most signif is Erythromycin, then Moxifloxacin
